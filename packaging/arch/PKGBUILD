# Maintainer: Jadocee
#
# jayos-sony-xm5, built from the checkout this file sits in.
#
#   cd packaging/arch && makepkg -si
#
# THIS IS THE RECIPE FOR A CHECKOUT, NOT FOR A RELEASE
#
# There is no source=() line: the source is the working tree two directories
# up, whatever it holds -- committed or not. That is the point of it: somebody
# changing the daemon builds and installs the change without pushing it first.
# jayos carries its own recipe for the other case, an install that fetches
# this repository from GitHub (jayos: pkgbuilds/jayos-sony-xm5/PKGBUILD); its
# check() reads _helpers here and refuses to build if the two lists differ.
#
# pkgver is the crate's version, written out. tests/shell/test-packaging.sh
# holds the two to each other. A pkgver() function would make makepkg rewrite
# this file on every build, and a recipe that edits itself in a checkout is a
# recipe whose diff nobody can read.

pkgname=jayos-sony-xm5
pkgver=1.0.0
pkgrel=1
pkgdesc="Sony WH-1000XM5 headphones over Bluetooth: noise control, battery and settings for the JayOS shell"
arch=('x86_64' 'aarch64')
url="https://github.com/Jadocee/jayos-sony-xm5"
license=('MIT')
# glibc and gcc-libs for the Rust binaries. bash, procps-ng (pgrep, pkill),
# util-linux (setsid) and jq for sony-daemon-process. bluez for bluetoothd,
# which qs-sonyd dials through, and bluez-utils for bluetoothctl, which it
# asks for the connected headset (src/bin/qs-sonyd.rs, find_headset).
depends=('glibc' 'gcc-libs' 'bash' 'procps-ng' 'util-linux' 'jq' 'bluez' 'bluez-utils')
# cargo is provided by the rustup package as well as by rust, so either
# toolchain satisfies makepkg.
makedepends=('cargo')
# !lto: makepkg's lto adds -flto=auto to C flags that reach nothing here; the
# Rust side has the profile's own fat LTO. !debug: the profile strips, and a
# -debug split package of a stripped build is empty.
options=('!lto' '!debug')

# The binaries this package installs, on one line. package() iterates this
# array rather than naming them twice, and jayos's integration check reads it
# to know which helpers a package provides.
_helpers=(qs-sony qs-sonyd)

# The checkout. Resolved, so a symlinked packaging/ directory still finds it.
_tree() { realpath "$startdir/../.."; }

prepare() {
    # The lockfile is the pin: --locked refuses to resolve anything Cargo.lock
    # does not already name, and the host target keeps the fetch to what this
    # machine builds. The toolchain name is for rustup; a plain rust package
    # ignores it.
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --manifest-path "$(_tree)/Cargo.toml" \
        --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    export RUSTUP_TOOLCHAIN=stable
    # Under $srcdir, so a CARGO_TARGET_DIR the building user set globally is
    # not where package() looks, and `makepkg -C` cleans it.
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --frozen --release --manifest-path "$(_tree)/Cargo.toml"
}

check() {
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --frozen --manifest-path "$(_tree)/Cargo.toml"
    local h
    for h in "${_helpers[@]}"; do
        [[ -x "$CARGO_TARGET_DIR/release/$h" ]] || {
            echo "_helpers names $h and the build produced no such binary" >&2
            return 1
        }
    done
}

package() {
    local tree h
    tree=$(_tree)
    for h in "${_helpers[@]}"; do
        install -Dm755 "$srcdir/target/release/$h" "$pkgdir/usr/bin/$h"
    done
    install -Dm755 "$tree/scripts/sony-daemon-process.sh" \
        "$pkgdir/usr/lib/$pkgname/sony-daemon-process"
    install -Dm644 "$tree/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$tree/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
    install -d "$pkgdir/usr/share/$pkgname/contract"
    install -m644 "$tree"/contract/* "$pkgdir/usr/share/$pkgname/contract/"
}
